# FIRENEXUS Staging Frontend Environment Configuration
# Copy this file to .env.staging or .env.production when deploying the staging frontend build.
# Vite bakes VITE_* variables into client static assets at build time.
# NEVER include database credentials, administrative keys, or private API secrets here.

# Staging Backend API Base URL (must use HTTPS in production/staging)
VITE_API_BASE_URL=https://staging-api.firenexus.org/api/v1
