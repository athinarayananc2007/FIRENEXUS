# FIRENEXUS Staging Environment Configuration
# Copy this file to .env.staging or set these environment variables in your staging host.
# NEVER commit real production or staging credentials to version control.

FLASK_ENV=staging
FLASK_APP=run.py
FLASK_DEBUG=0

PORT=5000
HOST=0.0.0.0

# Security: Generate a 64-character random string using `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace-with-a-cryptographically-secure-staging-secret-key-min-32-bytes
ADMIN_API_KEY=replace-with-a-cryptographically-secure-staging-admin-key-min-32-bytes

# NASA FIRMS API Credentials (Server-Side Only - NEVER expose to browser/client)
FIRMS_MAP_KEY=replace-with-your-nasa-firms-map-key
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# PostgreSQL + PostGIS Connection String
# Managed Provider Examples:
# Neon:      postgresql+psycopg2://user:password@ep-xyz.us-east-2.aws.neon.tech/firenexus?sslmode=require
# Supabase:  postgresql+psycopg2://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require
# Self-host: postgresql+psycopg2://firenexus_staging:strongpassword@staging-db.internal:5432/firenexus?sslmode=require
DATABASE_URL=postgresql+psycopg2://staging_user:staging_password@staging-postgres-host:5432/firenexus?sslmode=require

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# CORS Allowed Origins: Restrict strictly to your staging frontend domain(s)
CORS_ORIGINS=https://staging.firenexus.org,https://firenexus-staging.pages.dev

LOG_LEVEL=INFO
