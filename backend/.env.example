# ==============================================================================
# FIRENEXUS Backend Environment Configuration Template
# Copy this file to .env and adjust variables to match your local setup.
# ==============================================================================

# Flask Environment: development | testing | production
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1

# Application Server
PORT=5000
HOST=0.0.0.0

# Security (Change in production!)
SECRET_KEY=firenexus-dev-insecure-secret-key-replace-in-production
ADMIN_API_KEY=firenexus-admin-secret-key-replace-in-production

# NASA FIRMS API (Get your free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# PostgreSQL + PostGIS Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firenexus
TEST_DATABASE_URL=sqlite:///:memory:

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS Allowed Origins (Comma-separated)
# Matches existing Vite frontend dev server (port 5173) and default preview ports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

