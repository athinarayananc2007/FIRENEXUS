# ==============================================================================
# FIRENEXUS Backend Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Generate strong, random cryptographically secure keys for production!
# DO NOT commit real secrets or production .env files to version control.

# Application Environment
FLASK_ENV=production
FLASK_APP=run.py
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Core Security Secrets
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_character_cryptographically_secure_random_key
ADMIN_API_KEY=replace_with_32_character_cryptographically_secure_admin_key

# NASA FIRMS API Credentials
# Register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=replace_with_registered_nasa_firms_map_key

# Production PostgreSQL + PostGIS Connection
# Format: postgresql+psycopg2://<user>:<password>@<db-host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://firenexus_user:replace_with_strong_password@pg-cluster.internal:5432/firenexus
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Strict CORS Allowed Origins (Production Frontend Domains only)
CORS_ORIGINS=https://firenexus.earth,https://app.firenexus.earth

# Logging & Telemetry
LOG_LEVEL=INFO
